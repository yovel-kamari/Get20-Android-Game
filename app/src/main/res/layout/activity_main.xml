<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_main"
    android:padding="24dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Decorative Floating Tiles (Low Alpha) -->
    <ImageView
        android:id="@+id/bgTile1"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="120dp"
        android:layout_marginStart="-15dp"
        android:alpha="0.08"
        android:rotation="-20"
        android:src="@drawable/p1" />

    <ImageView
        android:id="@+id/bgTile2"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="250dp"
        android:layout_marginEnd="-10dp"
        android:alpha="0.08"
        android:rotation="15"
        android:src="@drawable/p2" />

    <ImageView
        android:id="@+id/bgTile3"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="200dp"
        android:layout_marginStart="40dp"
        android:alpha="0.07"
        android:rotation="10"
        android:src="@drawable/p3" />

    <ImageView
        android:id="@+id/bgTile4"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="30dp"
        android:alpha="0.06"
        android:rotation="25"
        android:src="@drawable/p4" />

    <ImageView
        android:id="@+id/bgTile5"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="100dp"
        android:layout_marginEnd="-20dp"
        android:alpha="0.06"
        android:rotation="-15"
        android:src="@drawable/p5" />

    <!-- Subtle glow behind the logo -->
    <View
        android:id="@+id/logoGlow"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="70dp"
        android:background="@drawable/circle_icon_bg"
        android:backgroundTint="#FFD54F"
        android:alpha="0.08" />

    <!-- Transparent board overlay -->
    <ImageView
        android:id="@+id/boardOverlay"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="25dp"
        android:alpha="0.1"
        android:scaleType="centerCrop"
        android:src="@drawable/background_get20" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:elevation="12dp"
        android:src="@drawable/background_get20" />

    <!-- Stats Card -->
    <LinearLayout
        android:id="@+id/statsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/logo"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="30dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/stats_card"
        android:elevation="10dp"
        android:padding="20dp">

        <TextView
            android:id="@+id/lblHighScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆 HIGH SCORE"
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/txtHighScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFD54F"
            android:textSize="48sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:shadowColor="#80FFD54F"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="15" />

        <View
            android:layout_width="80dp"
            android:layout_height="1.5dp"
            android:background="#33FFFFFF"
            android:layout_marginVertical="15dp"/>

        <TextView
            android:id="@+id/txtMaxTile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAX TILE: 0"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:alpha="0.85"
            android:letterSpacing="0.05" />

    </LinearLayout>

    <!-- Play Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/playButton"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="80dp"
        android:layout_marginHorizontal="30dp"
        android:text="PLAY"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:background="@drawable/btn_play_bg"
        android:elevation="16dp" />

</RelativeLayout>
