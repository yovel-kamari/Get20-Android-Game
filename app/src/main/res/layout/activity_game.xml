<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rootLayout"
    android:background="@drawable/background_main"
    android:layoutDirection="ltr">

    <!-- Custom game drawing view -->
    <com.example.get20.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Modern Score Card -->
    <LinearLayout
        android:id="@+id/scoreContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/stats_card"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="60dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp"
        android:elevation="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCORE"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/scoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFD54F"
            android:textSize="32sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Instruction text -->
    <TextView
        android:id="@+id/instructionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Double tap tiles to merge!"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#80FFFFFF"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="165dp"
        android:alpha="0.8" />

    <!-- Home button -->
    <ImageButton
        android:id="@+id/homeButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/outline_arrow_back_24"
        android:background="@drawable/circle_icon_bg"
        android:layout_gravity="top|left"
        android:elevation="4dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:contentDescription="Home"
        app:tint="#FFFFFF" />

    <!-- Restart button -->
    <ImageButton
        android:id="@+id/restartButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/baseline_refresh_24"
        android:background="@drawable/circle_icon_bg"
        android:layout_gravity="top|right"
        android:elevation="4dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:contentDescription="Restart"
        app:tint="#FFFFFF" />

    <!-- Dark Mode Toggle -->
    <ImageButton
        android:id="@+id/themeButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_dark_mode"
        android:background="@drawable/circle_icon_bg"
        android:layout_gravity="bottom|right"
        android:layout_margin="20dp"
        android:elevation="4dp"
        android:contentDescription="Toggle Theme"
        app:tint="#FFFFFF"/>
</FrameLayout>
