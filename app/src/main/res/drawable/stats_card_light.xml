<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Semi-transparent white for glass effect -->
    <solid android:color="#CCFFFFFF"/>
    <corners android:radius="24dp"/>

    <!-- Dark blue border -->
    <stroke
        android:width="1.5dp"
        android:color="#80004062"/>

    <!-- Matching the exact padding of the dark stats_card -->
    <padding
        android:left="28dp"
        android:right="28dp"
        android:top="22dp"
        android:bottom="22dp"/>
</shape>